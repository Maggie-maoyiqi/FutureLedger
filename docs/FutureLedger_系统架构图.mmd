    classDef data fill:#eaf0f7,stroke:#52769f,color:#203954,stroke-width:1.5px;
    classDef result fill:#e8f5e8,stroke:#4d8b55,color:#234b28,stroke-width:1.5px;
    class U,UI user;
    class ROUTER,IP,PARAM llm;
    class SAFE,AUTHZ,GATE,VAL,PV,PSTATE secure;
    class CTX,COMP,RO,DATA,ATOMIC data;
    class RES,DEF,SIM,REJECT result;
