# Example only. Replace YOUR_APIKEY and YOUR_MODEL_NAME locally; never commit a real key.
# The app does not automatically load this file. Export the same variables in the shell
# used to start Uvicorn, or add a dotenv loader locally (the real .env is git-ignored).

# Offline rule-based demo (no model API call):
FUTURELEDGER_PROVIDER=local

# Choose ONE provider configuration below and set its exact model ID.
# DeepSeek:
# FUTURELEDGER_PROVIDER=deepseek
# FUTURELEDGER_API_KEY=YOUR_APIKEY
# FUTURELEDGER_MODEL=YOUR_MODEL_NAME
# FUTURELEDGER_API_BASE=https://api.deepseek.com

# OpenAI:
# FUTURELEDGER_PROVIDER=openai
# FUTURELEDGER_API_KEY=YOUR_APIKEY
# FUTURELEDGER_MODEL=YOUR_MODEL_NAME
# FUTURELEDGER_API_BASE=https://api.openai.com/v1

# Any vendor exposing OpenAI-compatible Chat Completions + JSON mode (for example, a
# compatible endpoint from a domestic model provider):
# FUTURELEDGER_PROVIDER=compatible
# FUTURELEDGER_API_KEY=YOUR_APIKEY
# FUTURELEDGER_MODEL=YOUR_MODEL_NAME
# FUTURELEDGER_API_BASE=https://YOUR_PROVIDER_BASE_URL/v1

# Optional fixed date for reproducible demonstrations:
# FUTURELEDGER_TODAY=2026-10-26
